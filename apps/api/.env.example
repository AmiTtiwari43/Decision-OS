NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/decision_os
JWT_SECRET=development_jwt_secret_must_be_at_least_32_characters_long!
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

# Fallback AI Provider (Automatic failover if primary provider fails e.g. gemini -> openrouter)
FALLBACK_AI_PROVIDER=none
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=
